# =============================================================================
# Configuración Django - Instalación Mínima para Reportes
# =============================================================================

# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,synap.administranet.com.ar
ENVIRONMENT=development
REPORTS_CACHE_ENABLED=false
SITE_URL=https://synap.administranet.com.ar

# =============================================================================
# Base de Datos PostgreSQL (Synap - Base de datos principal)
# =============================================================================
POSTGRES_DB=synap_db
POSTGRES_USER=synap_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# Base de Datos MySQL (administraNET - Para autenticación)
# =============================================================================
DB_NAME=administranet
DB_USER=administranet
DB_PASSWORD=your_mysql_password
DB_HOST=your_mysql_host
DB_PORT=3306

# =============================================================================
# Redis (Opcional pero recomendado para cache)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Google OAuth (Opcional)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Cloudflare CDN (Opcional - Solo para producción)
# =============================================================================
# CLOUDFLARE_DOMAIN=synap.administranet.com.ar
