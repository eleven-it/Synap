# Variables para: docker compose -f docker-compose.administranet-ecom.yml --env-file administranet-ecom.docker.env
# Ajusta ECOM_PHP_SRC si el clon no está en la carpeta hermana de Synap.

ECOM_PHP_SRC=../administraNET-ecom

SYNAP_ECOM_DOCKER=1
SYNAP_MYSQL_HOST=Synap_mysql57
SYNAP_MYSQL_PORT=3306
SYNAP_MYSQL_USER=administranet
SYNAP_MYSQL_PASSWORD=administranet_local

RUN_COMPOSER_INSTALL=0
TZ=America/Argentina/Buenos_Aires
