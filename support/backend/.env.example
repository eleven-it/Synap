# Synap Support - Backend
# Copiar a .env y ajustar valores. No commitear .env.

# Entorno
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-in-production-use-long-random-string

# Configuración producto: clave para cifrar secretos en DB (tokens, API keys, etc.)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=
# Tests de canales/IA/storage: true = llamadas externas (Telegram, WhatsApp, SMTP, S3); false = solo validar estructura
ALLOW_EXTERNAL_TESTS=True

# Base de datos PostgreSQL
DATABASE_URL=postgres://support:support@localhost:5432/support
# Alternativa por variables:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=support
# POSTGRES_USER=support
# POSTGRES_PASSWORD=support

# Redis (broker Celery + cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Synap API (solo integración HTTP; no importar código Synap)
SUPPORT_SYNAP_API_URL=
SUPPORT_SYNAP_JWT_SECRET=

# RAG: embeddings para búsqueda vectorial (p. ej. misma key que Config IA)
OPENAI_API_KEY=
# EMBEDDING_DIMENSION=1536
# EMBEDDING_MODEL=text-embedding-3-small

# S3 / MinIO (adjuntos)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=support-attachments
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRES=3600
ATTACHMENT_MAX_SIZE_BYTES=10485760
# ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,application/pdf,...

# CORS (desarrollo)
CORS_ALLOW_ALL_ORIGINS=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.local
