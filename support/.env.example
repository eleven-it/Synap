# Synap Support – Configuración unificada
# Copiar a .env en este mismo directorio: cp .env.example .env
# Único archivo de variables: backend, Docker y frontend leen desde aquí. No commitear .env.

# ========== Entorno ==========
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-in-production-use-long-random-string

# ========== Cifrado de secretos (obligatorio para UI de configuración) ==========
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# ========== PostgreSQL (Compose: servicio db) ==========
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
POSTGRES_PORT=5432
# Backend local (sin Docker): usar DATABASE_URL. En Docker Compose se construye desde POSTGRES_*
DATABASE_URL=postgres://support:support@localhost:5432/support

# ========== Redis ==========
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ========== Puertos (Docker / desarrollo) ==========
BACKEND_PORT=8250
FRONTEND_PORT=3000

# ========== Synap API (RAG: GET /core/api/support/conocimiento/) ==========
# Local: http://localhost:8000. Docker: http://host.docker.internal:8000. Producción: https://synap.estrategiasdenegocios.ar
SUPPORT_SYNAP_API_URL=http://host.docker.internal:8000
# SUPPORT_SYNAP_JWT_SECRET=  # obligatorio si Synap está en production/produccion (mismo valor que en Synap)

# ========== Backend Django ==========
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOW_EXTERNAL_TESTS=True
CORS_ALLOW_ALL_ORIGINS=True
ALLOWED_HOSTS=localhost,127.0.0.1,synap.administranet.com.ar,support.estrategiasdenegocios.ar

# RAG: embeddings (opcional; puede configurarse desde la UI)
# OPENAI_API_KEY=
# EMBEDDING_DIMENSION=1536

# ========== S3 / MinIO (adjuntos; perfil storage) ==========
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=support-attachments
# S3_REGION=us-east-1
# S3_PRESIGNED_EXPIRES=3600
# ATTACHMENT_MAX_SIZE_BYTES=10485760

# ========== Frontend (Vite) ==========
# URL del API que verá el navegador. Docker dev: http://localhost:8250
VITE_API_BASE_URL=http://localhost:8250
# VITE_POLL_INTERVAL=10000

# ========== MinIO (perfil storage) ==========
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
