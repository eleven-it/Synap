# Synap Support – Frontend
# Solo variables mínimas. La configuración operativa (canales, IA, storage, etc.)
# se realiza desde la UI de Configuración (Admin) y se persiste en el backend.

# URL base de la API del backend (sin /api al final).
# En desarrollo con proxy de Vite puede dejarse vacío para usar rutas relativas.
VITE_API_BASE_URL=http://localhost:8250

# Opcional: intervalo de polling para actualizar datos (ms). 0 = desactivado.
# VITE_POLL_INTERVAL=10000
