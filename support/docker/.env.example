# Synap Support – Docker Compose
# Copiar a .env y ajustar. No commitear .env.

# --- PostgreSQL (servicio db) ---
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend (Django) ---
BACKEND_PORT=8250
SECRET_KEY=change-me-in-production-use-long-random-string

# Obligatoria para configuración por UI (tokens/API keys cifrados en DB)
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# Opcional
ALLOW_EXTERNAL_TESTS=True
# S3/MinIO (si usas perfil 'storage'): el backend debe poder alcanzar minio como 'minio:9000'
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=support-attachments

# --- Frontend (servicio frontend, perfil dev) ---
FRONTEND_PORT=3000
# URL que usará el navegador para llamar al API (host:backend_port)
VITE_API_BASE_URL=http://localhost:8250

# --- MinIO (perfil storage) ---
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.local
