# Synap — copiar a .env y ajustar (no commitear .env)
DJANGO_SETTINGS_MODULE=django_project.settings
ENVIRONMENT=development
DEBUG=True

# Permisos/roles Synap (ver docs/general/PERMISOS_SYNAP_STORE.md)
# Fuente de verdad runtime: legacy (default) | synap | dual
SYNAP_PERMISOS_SOURCE=legacy
SYNAP_AUTO_ENSURE_SCHEMA=True
SYNAP_BLOQUEAR_CREAR_PUESTOS=True
# (Legacy, en desuso) sync que inyectaba en permiso_sistema
SYNAP_AUTO_SYNC_PERMISSIONS=True
# Obligatorio si ENVIRONMENT=production o produccion
SECRET_KEY=cambiar-en-produccion-cadena-larga-aleatoria

ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# PostgreSQL (Django default)
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
# Obligatorio si ENVIRONMENT=production o produccion (no vacío)
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MySQL administraNET: clave AES contraseñas usuarios (misma que AdministraNET Gestión)
ADMINISTRANET_MYSQL_AES_KEY=a7v8xx2

# MySQL administraNET (conexión mysql)
DB_NAME=administranet
DB_USER=administranet
# Obligatorio si ENVIRONMENT=production o produccion
DB_PASSWORD=
DB_HOST=mysql
DB_PORT=3306

REDIS_URL=redis://redis:6379/0

# Support RAG: mismo valor en el .env del backend Support (SUPPORT_SYNAP_JWT_SECRET)
SUPPORT_SYNAP_JWT_SECRET=

# Geocodificación Google (solo servidor; no se acepta clave desde el cliente)
GOOGLE_GEOCODING_API_KEY=

SITE_URL=https://synap.administranet.com.ar

# AFIP / ARCA: directorio persistente para certificado y clave (fuera del bind mount del código).
# docker-compose.yml monta synap_afip_secrets en /var/lib/synap/afip y define SYNAP_AFIP_STORAGE para el servicio app.
# Sin esta variable: se usa <raíz del proyecto>/private/afip (desarrollo local sin Docker).
# SYNAP_AFIP_STORAGE=/var/lib/synap/afip

# OCR factura compra (heuristic | http)
FACTURA_COMPRA_OCR_ADAPTER=heuristic
FACTURA_COMPRA_OCR_HTTP_URL=
FACTURA_COMPRA_OCR_HTTP_BEARER_TOKEN=
FACTURA_COMPRA_OCR_HTTP_TIMEOUT=30
FACTURA_COMPRA_OCR_HTTP_VERIFY_SSL=True
# Tesseract (imágenes JPEG/PNG; requiere binario en el servidor)
FACTURA_COMPRA_OCR_TESSERACT_ENABLED=True
FACTURA_COMPRA_OCR_TESSERACT_LANG=spa+eng
FACTURA_COMPRA_OCR_TESSERACT_CMD=
# Motor OCR interno (solo JPEG/PNG): legacy | preprocess_only | structured_ocr
FACTURA_COMPRA_OCR_ENGINE_MODE=legacy

# Azure SQL BEST (solo lectura — Migración BEST → MPR)
# En docker compose, escapar $ del usuario con $$ (ej. interfase$$bestsox);
# si no, Compose interpreta $bestsox como variable vacía.
BEST_AZURE_SERVER=
BEST_AZURE_DATABASE=BEST
BEST_AZURE_USER=
BEST_AZURE_PASSWORD=
BEST_AZURE_PORT=1433
